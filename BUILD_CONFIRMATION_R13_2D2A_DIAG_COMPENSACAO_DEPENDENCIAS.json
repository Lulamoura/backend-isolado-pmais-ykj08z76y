  "structural_pseudocode": {
    "callback_signature": "$app.runInTransaction(function(txApp) { ... })",
    "operations_inside_callback": [
      "txApp.findFirstRecordByData('com_parametros', 'chave', LOCK_KEY) — concurrency guard: re-check lock state inside transaction",
      "if lock !== 'armed' → throw → native rollback (concurrency abort, nothing deleted)",
      "txApp.countRecords('com_eventos_integracao') — count before",
      "txApp.countRecords('com_execucoes_sincronizacao') — count before",
      "txApp.countRecords('com_vinculos_externos') — count before",
      "txApp.findRecordById('com_vinculos_externos', FIXED_ID) — fetch + identity compare",
      "txApp.findRecordById('com_eventos_integracao', FIXED_ID) — fetch + identity compare",
      "txApp.findRecordById('com_execucoes_sincronizacao', FIXED_ID) — fetch + identity compare",
      "txApp.findRecordsByFilter('com_ocorrencias_qualidade', filter) — reference absence check",
      "txApp.findRecordsByFilter('com_vinculos_externos', filter) — reference absence checks",
      "if preconditions not met → throw → native rollback (nothing deleted)",
      "txApp.delete(txApp.findRecordById('com_vinculos_externos', FIXED_ID)) — deletion order 1",
      "txApp.delete(txApp.findRecordById('com_eventos_integracao', FIXED_ID)) — deletion order 2",
      "txApp.delete(txApp.findRecordById('com_execucoes_sincronizacao', FIXED_ID)) — deletion order 3",
      "txApp.countRecords(...) — post-deletion count validation",
      "txApp.findRecordById(...) — post-deletion absence validation (expect throw = absent)",
      "if post-validation fails → throw → native rollback (nothing deleted, lock not consumed)",
      "txApp.findFirstRecordByData('com_parametros', 'chave', LOCK_KEY) — load lock record (already fetched in step 1)",
      "lockRec.set('valor', 'consumed') — transition lock state",
      "txApp.save(lockRec) — consume lock inside transaction (only on successful commit path)"
    ],
    "rollback_on_divergence": "Any divergence throws inside callback → native SQLite ROLLBACK → no records deleted, lock remains armed",
    "concurrency_guard": "Lock re-checked inside transaction via txApp.findFirstRecordByData — second concurrent request observes 'consumed' and throws before any deletion",
    "external_handle_rule": "$app, app, or any other external handle is NEVER used inside the transaction callback — only txApp"
  },
